# ==== Mẫu cấu hình HapiCopi ====
# Cách 1 (khuyên dùng cho bản build): Mở menu HapiCopi ở khay hệ thống > "Cài đặt..." để nhập API key.
#   Cấu hình sẽ được lưu tại: %APPDATA%\HapiCopi\config.env
# Cách 2 (cho lập trình viên): Đổi tên file này thành .env và điền các giá trị bên dưới.

# Nhà cung cấp AI: gemini hoặc openrouter
AI_PROVIDER=gemini

# Gemini (lấy key tại: https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter (tùy chọn, lấy key tại: https://openrouter.ai/keys)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_MODEL=openai/gpt-oss-120b:free
